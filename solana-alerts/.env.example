# --- Telegram ---
# @BotFather -> /newbot -> token
TELEGRAM_TOKEN=123456789:AAExampleTokenReplaceMe
# not required: bot learns it when you send /start to it
TELEGRAM_CHAT_ID=

# --- server ---
PORT=8787
HOST=0.0.0.0
POLL_MS=5000

# assets to track (comma separated)
ASSETS=SOL

# quote currency shown next to USD (GEL / EUR / RUB ... empty = off)
FIAT=GEL

# optional password for the dashboard (empty = no password, LAN only)
ACCESS_KEY=

# repeat-alert cooldown in minutes
COOLDOWN_MIN=15
